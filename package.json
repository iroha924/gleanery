{
  "name": "mitos",
  "private": true,
  "scripts": {
    "dev": "bun run --parallel --no-orphans api dashboard",
    "api": "cd server && node src/http.ts",
    "dashboard": "cd dashboard && ./node_modules/.bin/vite",
    "build": "cd dashboard && ./node_modules/.bin/vite build",

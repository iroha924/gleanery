{
  "name": "gleanery",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "setup": "bun install --cwd server --frozen-lockfile",
    "cli": "node server/src/cli.ts",
    "lint": "bunx --bun @biomejs/biome@2.5.14 check .",
    "verify:ai": "node scripts/check-ai-config.mjs",
    "architecture": "node scripts/check-architecture.mjs",
    "typecheck": "bun run --cwd server typecheck",
    "check": "bun run lint && bun run verify:ai && bun run naming && bun run pairs && bun run rule-scopes && bun run sql && bun run architecture && bun run codegen:check && bun run typecheck",
    "test": "bun run --cwd server test",
    "verify": "bun run check && bun run bundle && bun run sql:reach && bun run sql:live",
    "bundle": "node scripts/bundle.mjs",
    "release:plan": "node scripts/release-plan.mjs",
    "release:status": "node scripts/release-status.mjs",
    "codegen": "node scripts/codegen.mjs",
    "evals:retrieval": "node server/evals/retrieval.ts",
    "evals:agentic": "node server/evals/agentic/run.ts",
    "evals:judge": "node server/evals/agentic/judge.ts",
    "codegen:check": "node scripts/codegen.mjs --check",
    "sql:reach": "node scripts/check-sql-reach.mjs",
    "sql:live": "node scripts/check-sql-live.mjs",
    "naming": "node scripts/check-naming.mjs",
    "notices": "node scripts/third-party-notices.mjs --check",
    "pairs": "node scripts/check-pairs.mjs",
    "rule-scopes": "node scripts/check-rule-scopes.mjs",
    "sql": "node scripts/check-sql.mjs"
  }
}

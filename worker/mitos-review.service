[Unit]
Description=開いている PR を隔離コンテナでレビューして投稿する
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
# **`__HOME__` と `__USER__` は入れるときに埋める**（scripts/com.mitos.sync.plist と同じ形）。
# 置き場所はマシンごとに違うので、リポジトリには絶対パスを書かない。
ExecStart=__HOME__/mitos-worker/poll-prs.sh
# **1 回ぶんに上限を置く。**レビューが詰まったまま次の起動が重なるのを防ぐ。
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "services": {
    "dashboard": {
      "root": "dashboard/",
      "framework": "nextjs"
    },
    "api": {
      "root": "server/",
      "framework": "hono",
      "entrypoint": "src/server.ts",
      "buildCommand": "echo 'Vercel の型検査は飛ばす（@vercel/backends が TypeScript 7 で落ちる）。tsc は pre-commit と bun run check で通している'"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "dashboard"
      }
    }
  ]
}

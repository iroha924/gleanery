#!/usr/bin/env node
// 作業したのに記録せずに終わったとき、それを伝える。
//
// **止めない。**SessionEnd は exit code 2 を無視し、セッションは既に閉じかけている
// （公式: "Cannot block" / "Cannot prompt"）。できるのは systemMessage を出すことだけで、
// それでよい。残すかどうかは人が決めることで、フックが決めることではない。
//
// **systemMessage は最上位に置く。**hookSpecificOutput の中へ入れると
// hookEventName の enum に "SessionEnd" が無く、検証で落ちて何も表示されない
// （実測 2026-09-08: 書いてから一度も表示されていなかった）。
//
// **作業したかどうかは git で見る。transcript のツール呼び出しでは見ない。**
// heredoc や python -c で書いたファイルはツールの引数に現れないので、
// 数えると 0 件になる（実測 2026-09-08: 6 ファイルを書いたセッションで 0 件）。
// 拾おうとするとシェルの構文解析になり、そこに終端は無い。
// 同じ判断が d-git-not-shell-parsing（2026-09-05）に既にある。
//
// **git だけでは足りない。**コードを触らず設計だけ議論したセッションでは変更が 0 件になり、
// 一度も促されない。**保存を忘れて最も痛いのがそのセッションである**（判断が会話の中にしか無い）。
// だから「人がどれだけ話したか」も見る。
//
// **閾値は実測から。**この作業場所の 21 セッションで、人の発話は 0-1 件が 19 本、
// 32 件と 77 件が 2 本。間が完全に空いているので、どこに置いても同じ結果になる。
// 5 件は probe の 5 倍・実作業の 1/6 で、両側に余裕がある。
// `d-session-end-hint` が棄却した「常に促す」とは別物 — 読むだけのセッションでは黙る。
//
// **番兵は 1 行 1 JSON として探す。文字列一致で見ない。**
// このファイル自身を開いたセッションでは、番兵が tool_result に載って
// 記録していないのに黙る（実測 2026-09-08）。
//
// **ESM で書く。**plugin/package.json が "type": "module" なので、
// 拡張子の無いこのファイルも ESM として読まれ、require は使えない。
import { execFileSync } from "node:child_process";
import fs from "node:fs";

/** 判断を残した合図。**スキルを起動したかどうかで見る** — 完走したかは transcript から判らない。 */
const TRACED = "<command-name>/mitos:trace</command-name>";

/**
 * git の出力の行数。**失敗したら 0 を返す。投げない。**
 * cwd がリポジトリでないときに投げると、外側の catch に飲まれて
 * 発話での判定まで到達せず、議論だけのセッションで黙る（実測）。
 */
const git = (cwd, args) => {
  try {
    return execFileSync("git", ["-C", cwd, ...args], {
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"],
    })
      .split("\n")
      .filter(Boolean).length;
  } catch {
    return 0;
  }
};

try {
  let raw = "";
  for await (const chunk of process.stdin) raw += chunk;
  const input = JSON.parse(raw || "{}");
  const file = input.transcript_path;
  const cwd = input.cwd;
  if (!file || !cwd || !fs.existsSync(file)) process.exit(0);

  /** 人が打った発言。貼り付けと通知は数えない。 */
  const BOILERPLATE =
    /^(Base directory for this skill|<|\/|This session is being continued|Caveat: The messages below|Another Claude session sent a message|# Claude in Chrome|\(Re-invocation of|\[Image: source:)/;
  const SAID = 5;

  let startedAt = null;
  let said = 0;
  for (const line of fs.readFileSync(file, "utf8").split("\n")) {
    if (!line) continue;
    let entry;
    try {
      entry = JSON.parse(line);
    } catch {
      continue; // 書きかけの行は飛ばす
    }
    startedAt ??= entry.timestamp ?? null;
    // 起動は人の発言として載る。tool_result（ファイルを読んだ中身）は数えない
    if (entry.type !== "user") continue;
    const content = entry.message?.content;
    const texts =
      typeof content === "string"
        ? [content]
        : Array.isArray(content)
          ? content.filter((b) => b?.type === "text").map((b) => b.text ?? "")
          : [];
    if (texts.some((t) => t.includes(TRACED))) process.exit(0);
    for (const t of texts) {
      const body = t.trim();
      if (body.length >= 15 && !BOILERPLATE.test(body)) said++;
    }
  }

  const changed = git(cwd, ["status", "--porcelain"]);
  const commits = startedAt ? git(cwd, ["log", "--oneline", `--since=${startedAt}`]) : 0;
  const touched = changed > 0 || commits > 0;
  if (!touched && said < SAID) process.exit(0);

  const what = touched
    ? `リポジトリが変わりました（未コミット ${changed} ファイル / コミット ${commits} 件）`
    : `${said} 回やりとりしました（コードは変わっていません）`;
  process.stdout.write(
    JSON.stringify({
      systemMessage:
        `このセッションで${what}が、判断を記録していません。` +
        `次に同じ作業へ戻るとき、何をなぜ決めたかは git log から復元できません。` +
        `残すなら /mitos:trace です。`,
    }),
  );
} catch {
  // 何が起きても終了は止めない。促しは、失敗しても実害の無い機能である。
}

  "decisions": [
    {
      "id": "d-async-worker",
      "at": "2026-08-30T11:00:00+09:00",
      "status": "accepted",
      "context": "月次バッチの所要時間の 8 割が PDF 生成で、締め処理の開始が翌営業日にずれていた。PDF の URL は外部が参照しているため形を変えられない。",
      "decision": "PDF の生成を専用ワーカーへ切り出し、バッチは生成ジョブを積むだけにする",
      "options": [
        {
          "option": "専用ワーカーへ切り出す",
          "chosen": true
        },
        {
          "option": "リクエスト内で同期生成する",
          "whyNot": "100 件を超えるとロードバランサの 60 秒上限でタイムアウトした（e-sync-in-request）"
        },
        {
          "option": "バッチのまま並列度を上げる",
          "whyNot": "バッチが PDF の完了を待つ構造が変わらないため、生成が遅れれば締めも遅れる。原因を残したまま症状だけ薄める"
        }
      ],
      "consequences": [
        {
          "text": "バッチの所要時間が計算処理ぶんだけになり、35 分程度に収まる見込み",
          "good": true
        },
        {
          "text": "PDF が「まだ無い」状態が新たに生まれる。管理画面に生成状態の表示が要る",
          "good": false
        },
        {
          "text": "ワーカーの死活監視が新しく必要になり、運用の対象が 1 つ増える",
          "good": false
        }
      ],
      "confirmation": "月次バッチのジョブ実行時間が 30 分未満であることを、9 月の本番実行のログで確かめる。あわせて生成完了までの時間が 15 分以内であることを管理画面の生成状態のタイムスタンプで見る",
      "evidence": [
        {
          "kind": "commit",
          "ref": "a91f3c2"
        },
        {
          "kind": "issue",
          "ref": "#398"
        }
      ]
    },

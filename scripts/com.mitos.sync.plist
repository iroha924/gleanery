<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mitos.sync</string>
  <!-- **追記で残す。**launchd の StandardOutPath は毎回上書きするので、
       素で渡すと前日のログが消える（実測: plist を 9/6 に置いて 9/8 の 1 回分しか残っていなかった）。
       sh -c で >> にして、ログを 2000 行で切る。 -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>L=$HOME/.claude/mitos-sync.log; __MITOS_DIR__/plugin/bin/mitos sync &gt;&gt;"$L" 2&gt;&amp;1; rc=$?; tail -n 2000 "$L" &gt; "$L.tmp" &amp;&amp; mv "$L.tmp" "$L"; exit $rc</string>
  </array>
  <!-- 毎日 6:00。寝ている間に終わらせる -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
  <!-- スリープで飛んだら起きたときに 1 回だけ走らせる -->
  <key>RunAtLoad</key><false/>
  <key>StandardErrorPath</key><string>__HOME__/.claude/mitos-sync-launchd.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd は PATH をほぼ持たない。gh と claude と node の場所を通す -->
    <key>PATH</key><string>__HOME__/.local/bin:__HOME__/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [":semanticCommits"],
  "enabledManagers": ["bun"],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 6am on the first day of the month"],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "matchManagers": ["bun"],
      "groupName": "bun の依存",
      "separateMajorMinor": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "prConcurrentLimit": 2
}

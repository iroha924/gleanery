{
  "name": "mitos-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "mitos の MCP・CLI・自動記録・画面の API（手元の PostgreSQL と Voyage、OpenAI）",
  "scripts": {
    "check": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "mcp": "node src/mcp.ts",
    "api": "node src/server.ts --dev"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "0.9.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@stricli/core": "1.3.0",
    "hono": "4.13.7",
    "openai": "^7.10.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "lefthook": "^2.1.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}

    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.13.6",
    "js-tokens": "10.0.0",
    "knip": "6.36.0",
    "kysely-codegen": "0.20.0",
    "lefthook": "^2.1.14",

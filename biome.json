{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "server/src/**",
      "server/test/**",
      "server/evals/**",
      "scripts/**/*.mjs",
      "scripts/**/*.ts",
      "scripts/**/*.mts",
      "server/*.json",
      "*.json",
      "!server/src/db-types.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUndeclaredDependencies": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["server/test/**"],
      "linter": { "rules": { "suspicious": { "noSkippedTests": "error" } } }
    }
  ]
}

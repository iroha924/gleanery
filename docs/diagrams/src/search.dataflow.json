    { "id": "fuse", "label": "束ねる" },
    { "id": "out", "label": "返す" }
  ],
  "nodes": [
    { "id": "question", "kind": "source", "label": "問い", "note": "knowledge・avoid・said", "stage": "in", "row": 0 },
    { "id": "db", "kind": "source", "label": "知識と発言", "note": "Neon・reader の鍵", "icon": "logo:neon-icon", "stage": "in", "row": 1 },
    { "id": "scope", "kind": "transform", "label": "範囲と種類で絞る", "note": "既定はいまの作業場所", "stage": "narrow", "row": 0 },
    { "id": "lex", "kind": "transform", "label": "語彙で探す", "note": "Segmenter と tsvector", "stage": "search", "row": 0 },
    { "id": "dense", "kind": "transform", "label": "意味で探す", "note": "Voyage・halfvec 全件", "stage": "search", "row": 1 },
    { "id": "rrf", "kind": "transform", "label": "RRF で束ねる", "note": "k=60", "stage": "fuse", "row": 0 },
    { "id": "rerank", "kind": "transform", "label": "rerank-3 で並べる", "note": "札を前置した上位 30", "stage": "fuse", "row": 1 },
    { "id": "hits", "kind": "consumer", "label": "5 件を返す", "note": "出自つき・4KB まで", "stage": "out", "row": 0 },

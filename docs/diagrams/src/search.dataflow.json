      { "id": "recall", "label": "recall", "focus": ["question", "db", "scope", "lex", "dense", "rrf", "rerank", "hits"], "note": "判断・発言を探し、出自つきで 5 件を返す。" },
      { "id": "read", "label": "read", "focus": ["hits", "read", "db"], "note": "返した参照の全文を、同じ範囲の中だけで読む。" }
    ]
  },
  "stages": [
    { "id": "in", "label": "入力" },
    { "id": "narrow", "label": "絞り込み" },

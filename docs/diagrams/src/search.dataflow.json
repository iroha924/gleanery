    { "from": "dense", "to": "rrf", "label": "上位 40" },
    { "from": "rrf", "to": "rerank", "label": "上位 30" },
    { "from": "rerank", "to": "hits", "label": "5 件" },
    { "from": "hits", "to": "read", "label": "参照 k: m: s: w:", "style": "dashed" }

{
  "type": "sequence",
  "meta": {
    "title": "会話の自動記録",
    "subtitle": "フックは手元の待ち行列（~/.claude/mitos-spool）へ書くだけ。DB へは turn の終わりに、切り離した送信プロセスが届ける",
    "views": [
      {
        "id": "record",
        "label": "書く",
        "focus": [
          "msg-1",
          "msg-2",
          "msg-3",
          "msg-4",
          "msg-5",
          "msg-6"
        ],
        "note": "持ち主の turn だけを、伏せ字にしてから待ち行列へ。"
      },
      {
        "id": "send",
        "label": "送る",
        "focus": [
          "msg-7",
          "msg-8",
          "msg-9",
          "msg-10",
          "msg-11"
        ],
        "note": "DB に届かなければ待ち行列に残し、次に冪等に送り直す。"
      },
      {
        "id": "mark",
        "label": "持ち主の判定",
        "focus": [
          "msg-0",
          "msg-3"
        ],
        "note": "子の session・subagent・印の無い headless・通知と伝言は残さない。"
      }
    ]
  },
  "participants": [
    {
      "id": "owner",
      "kind": "external",
      "label": "持ち主"
    },
    {
      "id": "cc",
      "kind": "external",
      "label": "Claude Code",
      "icon": "logo:claude-icon"
    },
    {
      "id": "hook",
      "kind": "backend",
      "label": "フック（capture.js）"
    },
    {
      "id": "spool",
      "kind": "queue",
      "label": "待ち行列"
    },
    {
      "id": "sender",
      "kind": "backend",
      "label": "送信プロセス"
    },
    {
      "id": "voyage",
      "kind": "external",
      "label": "Voyage"
    },
    {
      "id": "neon",
      "kind": "database",
      "label": "Neon",
      "icon": "logo:neon-icon"
    }
  ],
  "messages": [
    {
      "from": "cc",
      "to": "hook",
      "label": "SessionStart：子へ印を継ぐ・止まっていれば警告"
    },
    {
      "from": "owner",
      "to": "cc",
      "label": "発言を送る"
    },
    {
      "from": "cc",
      "to": "hook",
      "kind": "async",
      "label": "UserPromptSubmit"
    },
    {
      "from": "hook",
      "to": "hook",
      "kind": "self",
      "label": "持ち主の発言か（subagent・子・通知を外す）"
    },
    {
      "from": "hook",
      "to": "spool",
      "kind": "async",
      "label": "伏せ字にした発言を 1 件書く"
    },
    {
      "from": "cc",
      "to": "hook",
      "kind": "async",
      "label": "PostToolUse：触ったファイルも書く"
    },
    {
      "from": "cc",
      "to": "hook",
      "kind": "async",
      "label": "Stop：AI の応答も書く（SubagentStop は報告を画面へ）"
    },
    {
      "from": "hook",
      "to": "sender",
      "kind": "async",
      "label": "送信を切り離して起動"
    },
    {
      "from": "sender",
      "to": "spool",
      "label": "lock を取り、溜まった記録を読む"
    },
    {
      "from": "sender",
      "to": "voyage",
      "label": "持ち主の発言を埋め込む"
    },
    {
      "from": "sender",
      "to": "neon",
      "label": "表ごとに 1 往復で追記（capture の鍵）"
    },
    {
      "from": "sender",
      "to": "spool",
      "kind": "return",
      "label": "送れた分を消す・拒まれたら rejected/ へ"
    }
  ]
}

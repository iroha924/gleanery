{
  "type": "workflow",
  "meta": {
    "title": "毎日の同期（mitos sync）",
    "subtitle": "GitHub は毎回全件を取る。文書は remote の既定 branch の commit から fast-forward だけを入れる（書くのは ingest の鍵）",
    "views": [
      {
        "id": "github",
        "label": "GitHub",
        "focus": [
          "start",
          "gh_fetch",
          "gh_write",
          "embed",
          "done"
        ],
        "note": "変わった行だけ書き、消えた PR・発言を消す。"
      },
      {
        "id": "docs",
        "label": "文書",
        "focus": [
          "start",
          "git_fetch",
          "tree",
          "ff",
          "write_docs",
          "embed",
          "done"
        ],
        "note": "作業ツリーは読まない。承認済みの成果物だけを入れる。"
      },
      {
        "id": "stop",
        "label": "止まるとき",
        "focus": [
          "tree",
          "ff",
          "recheck",
          "noop",
          "stop"
        ],
        "note": "巻き戻しと分岐は書かずに止め、画面と doctor に出す。"
      }
    ]
  },
  "lanes": [
    {
      "id": "cli",
      "label": "CLI"
    },
    {
      "id": "git",
      "label": "git"
    },
    {
      "id": "gh",
      "label": "GitHub"
    },
    {
      "id": "db",
      "label": "Neon"
    },
    {
      "id": "voyage",
      "label": "Voyage"
    }
  ],
  "nodes": [
    {
      "id": "start",
      "kind": "start",
      "label": "作業場所を探す",
      "note": "毎日 6:00・手動",
      "lane": "cli",
      "col": 0
    },
    {
      "id": "gh_fetch",
      "kind": "step",
      "label": "全件を取る",
      "note": "PR・issue・発言",
      "lane": "gh",
      "col": 1
    },
    {
      "id": "git_fetch",
      "kind": "step",
      "label": "既定 branch を取る",
      "note": "origin HEAD",
      "lane": "git",
      "col": 1
    },
    {
      "id": "gh_write",
      "kind": "step",
      "label": "変わった行だけ書く",
      "note": "古い取得は書かない",
      "lane": "db",
      "col": 1
    },
    {
      "id": "tree",
      "kind": "gate",
      "label": "tree を検査",
      "note": ".mitos の承認",
      "lane": "git",
      "col": 2
    },
    {
      "id": "ff",
      "kind": "decision",
      "label": "fast-forward か",
      "lane": "db",
      "col": 2
    },
    {
      "id": "write_docs",
      "kind": "step",
      "label": "文書と節を書く",
      "note": "消えた文書は消す",
      "lane": "db",
      "col": 3
    },
    {
      "id": "recheck",
      "kind": "decision",
      "label": "取り直して進んだか",
      "lane": "git",
      "col": 3
    },
    {
      "id": "noop",
      "kind": "end",
      "label": "何も書かない",
      "note": "別の同期が先",
      "lane": "db",
      "col": 4
    },
    {
      "id": "stop",
      "kind": "error",
      "label": "書かずに止める",
      "note": "last_error",
      "lane": "cli",
      "col": 3
    },
    {
      "id": "embed",
      "kind": "step",
      "label": "埋め込みを取る",
      "note": "最後に 1 回",
      "lane": "voyage",
      "col": 4
    },
    {
      "id": "done",
      "kind": "end",
      "label": "同期おわり",
      "lane": "cli",
      "col": 4
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "gh_fetch"
    },
    {
      "from": "start",
      "to": "git_fetch"
    },
    {
      "from": "gh_fetch",
      "to": "gh_write"
    },
    {
      "from": "git_fetch",
      "to": "tree"
    },
    {
      "from": "tree",
      "to": "ff",
      "label": "通った"
    },
    {
      "from": "tree",
      "to": "stop",
      "label": "不正"
    },
    {
      "from": "ff",
      "to": "write_docs",
      "label": "はい・初回"
    },
    {
      "from": "ff",
      "to": "recheck",
      "label": "いいえ"
    },
    {
      "from": "recheck",
      "to": "noop",
      "label": "進んでいた"
    },
    {
      "from": "recheck",
      "to": "stop",
      "label": "巻き戻し・分岐"
    },
    {
      "from": "gh_write",
      "to": "embed"
    },
    {
      "from": "write_docs",
      "to": "embed"
    },
    {
      "from": "embed",
      "to": "done"
    }
  ]
}